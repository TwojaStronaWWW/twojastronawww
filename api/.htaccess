# Ochrona danych osobowych, sekretów .env i plików CSV/JSON (ISO 27001 & RODO)
<FilesMatch "(\.env.*|\.(csv|json|log|lock|txt|md))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
