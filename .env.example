# Szablon zmiennych środowiskowych (ISO 27001 — Zero Secrets in Git)
# Skopiuj ten plik do .env poza katalogiem publicznym (lub w głównym katalogu niepublicznym)
# NIGDY nie commituj rzeczywistego pliku .env do repozytorium Git!

OSTICKET_API_KEY="WSTAW_TUTAJ_KLUCZ_API_OSTICKET_32_ZNAKI"
OSTICKET_API_URL="http://hd.twojastronawww.pl:8080/ticket_hook.php"
OSTICKET_FALLBACK_URL="https://hd.twojastronawww.pl/ticket_hook.php"
CONTACT_EMAIL="kontakt@twojadomena.pl"
CENTRAL_LEAD_EMAIL="kontakt@twojastronawww.pl"
BRAND_NAME="TwojaStronaWWW"
NTFY_TOPIC="WSTAW_TUTAJ_SEKRETNY_TEMAT_NTFY"

# Poświadczenia panelu RODO Lead Manager (api/admin.php)
ADMIN_PASSWORD_HASH="$2y$10$WSTAW_TUTAJ_HASH_BCRYPT_HASLA_ADMINA"
ADMIN_PIN="WSTAW_TUTAJ_OPCJONALNY_PIN_ADMINA"

# Cloudflare R2 Object Storage (publiczne media + prywatny backup leadów CSV)
R2_ACCOUNT_ID="WSTAW_ACCOUNT_ID_CLOUDFLARE"
R2_ACCESS_KEY_ID="WSTAW_ACCESS_KEY_ID_R2"
R2_SECRET_ACCESS_KEY="WSTAW_SECRET_ACCESS_KEY_R2"
R2_BUCKET_NAME="twojastronawww-media"
R2_PRIVATE_BUCKET_NAME="twojastronawww-private-backups"
R2_PUBLIC_URL="https://media.twojastronawww.pl"
