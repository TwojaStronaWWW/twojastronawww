# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit hook scripts and shell scripts must strictly use LF
*.sh text eol=lf
.githooks/* text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.mp4 binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
